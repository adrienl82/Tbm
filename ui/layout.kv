#:import dp kivy.metrics.dp

<StopRow>:
    size_hint_y: None
    height: dp(48)
    padding: dp(12), 0
    Label:
        text: root.stop_name
        halign: "left"
        valign: "middle"
        text_size: self.size

<PassageRow>:
    size_hint_y: None
    height: dp(56)
    padding: dp(12), dp(4)
    spacing: dp(8)
    Label:
        text: root.line_code
        bold: True
        size_hint_x: 0.2
    Label:
        text: root.destination
        halign: "left"
        valign: "middle"
        text_size: self.size
        size_hint_x: 0.55
    Label:
        text: root.eta_text
        size_hint_x: 0.25

<SearchScreen>:
    BoxLayout:
        orientation: "vertical"
        TextInput:
            id: search_input
            size_hint_y: None
            height: dp(48)
            multiline: False
            hint_text: "Rechercher un arret (ex: Quinconces)"
            on_text: root.on_search_text(self.text)
        ScrollView:
            BoxLayout:
                id: results
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
        Button:
            text: "Mes favoris"
            size_hint_y: None
            height: dp(48)
            on_release: app.manager.current = "favorites"

<BoardScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Button:
                text: "< Retour"
                size_hint_x: 0.3
                on_release: app.manager.current = "search"
            Label:
                text: root.stop_name
            Button:
                id: favorite_button
                text: "☆ Ajouter aux favoris"
                size_hint_x: 0.4
                on_release: root.toggle_favorite()
        Label:
            text: root.status_text
            size_hint_y: None
            height: dp(24) if root.status_text else 0
        ScrollView:
            BoxLayout:
                id: passages
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height

<FavoritesScreen>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Button:
                text: "< Retour"
                size_hint_x: 0.3
                on_release: app.manager.current = "search"
            Label:
                text: "Mes favoris"
        ScrollView:
            BoxLayout:
                id: favorites
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
